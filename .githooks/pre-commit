#!/bin/sh

files=$(git diff --cached --name-only --diff-filter=ACM)

for file in $files
do
    case "$file" in
        .githooks/*) continue ;;
    esac

    if [ -f "$file" ] && grep -n "TODO" "$file" >/dev/null 2>&1
    then
        echo "ERROR: TODO found in $file"
        echo "Commit blocked!"
        exit 1
    fi
done

echo "Pre-commit check passed!"
exit 0